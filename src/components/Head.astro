---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  canonicalURL: URL;
  imageURL?: URL | null;
  ogType?: string;
  siteName: string;
}

const { title, description, canonicalURL, imageURL, ogType = 'website', siteName } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="6os4YXoXGlaJ6ewWany54HNvp23dq37h90ANpXd4SOg" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" href={withBase('/favicon.ico')} />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
<title>{title}</title>

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{imageURL && <meta property="og:image" content={imageURL} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}

<script is:inline>
  const storedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.dataset.theme = storedTheme || (prefersDark ? 'dark' : 'light');
</script>